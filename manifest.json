{
  "manifest_version": 3,
  "name": "商品信息采集助手",
  "description": "手动采集当前 SHEIN、Temu 等商品页的标题、商品 ID、SKU、规格、店铺和价格信息。",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "采集商品信息",
    "default_popup": "src/popup.html"
  }
}
